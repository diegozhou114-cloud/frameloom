<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/Contracts/**/*.cs" Link="Network/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/Runtime/IRealtimeChannelFactory.cs" Link="Network/Runtime/IRealtimeChannelFactory.cs" />
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/Runtime/RealtimeChannelFactoryRegistry.cs" Link="Network/Runtime/RealtimeChannelFactoryRegistry.cs" />
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/Runtime/RealtimeConnectionController.cs" Link="Network/Runtime/RealtimeConnectionController.cs" />
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/WebGL/INativeWebSocketClient.cs" Link="Network/WebGL/INativeWebSocketClient.cs" />
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/Network/WebGL/WebGlRealtimeChannel.cs" Link="Network/WebGL/WebGlRealtimeChannel.cs" />
    <Compile Include="../../Assets/Tests/Network/RealtimeCodecTests.cs" Link="Tests/Network/RealtimeCodecTests.cs" />
    <Compile Include="../../Assets/Tests/Network/BoundedMessagePumpTests.cs" Link="Tests/Network/BoundedMessagePumpTests.cs" />
    <Compile Include="../../Assets/Tests/Network/AuthenticatedPacketCodecTests.cs" Link="Tests/Network/AuthenticatedPacketCodecTests.cs" />
    <Compile Include="../../Assets/Tests/Network/RealtimeConnectionControllerTests.cs" Link="Tests/Network/RealtimeConnectionControllerTests.cs" />
    <Compile Include="../../Assets/Tests/Network/WebGlRealtimeChannelBoundaryTests.cs" Link="Tests/Network/WebGlRealtimeChannelBoundaryTests.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
