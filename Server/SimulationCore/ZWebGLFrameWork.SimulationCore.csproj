  <ItemGroup>
    <Compile Include="../../Packages/com.zwebglframework.runtime/Runtime/SimulationCore/**/*.cs" Link="SimulationCore/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
